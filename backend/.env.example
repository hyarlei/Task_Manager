# Environment variables
NODE_ENV=development
PORT=3001

# Database
DATABASE_URL="file:./dev.db"

# Para produção no Render/Railway, use SQLite ou PostgreSQL:
# DATABASE_URL="file:./prod.db"
# DATABASE_URL=postgresql://username:password@host:port/database

# JWT Secret (OBRIGATÓRIO: mude isso no seu .env de produção!)
JWT_SECRET=seu-jwt-secret-super-seguro-aqui-256-bits
JWT_REFRESH_SECRET=seu-jwt-refresh-secret-super-seguro-aqui-256-bits

# CORS
FRONTEND_URL=http://localhost:3000

# Para produção:
# FRONTEND_URL=https://seu-frontend.vercel.app